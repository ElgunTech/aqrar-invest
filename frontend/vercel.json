{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://aqrar-invest-api.onrender.com/api/:path*" },
    { "source": "/mock-mygov/:path*", "destination": "https://aqrar-invest-api.onrender.com/mock-mygov/:path*" },
    { "source": "/v3/:path*", "destination": "https://aqrar-invest-api.onrender.com/v3/:path*" },
    { "source": "/swagger-ui/:path*", "destination": "https://aqrar-invest-api.onrender.com/swagger-ui/:path*" },
    { "source": "/swagger-ui.html", "destination": "https://aqrar-invest-api.onrender.com/swagger-ui.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
